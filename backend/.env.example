# --- AI providers (Groq for chat, Voyage for embeddings) ---
GROQ_API_KEY=your_groq_api_key_here
VOYAGE_API_KEY=your_voyage_api_key_here

# Models per job (these are the defaults; change one to compare models)
AI_CHAT_MODEL=openai/gpt-oss-20b
AI_ANSWER_MODEL=openai/gpt-oss-20b
AI_GRADER_MODEL=openai/gpt-oss-120b
AI_EMBEDDING_MODEL=voyage-4-lite

# Paid AI calls are refused once this month's logged spend reaches this amount
AI_MONTHLY_BUDGET_USD=5

# --- Auth between the Next.js frontend and this backend ---
# Must match NEXTAUTH_SECRET in the frontend's env
INTERNAL_API_SECRET=replace_with_the_same_value_used_by_frontend

# --- Supabase (documents, conversations, PDF storage) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=your_actual_bucket_name

# --- Turn off third-party telemetry from Chroma and its dependencies ---
ANONYMIZED_TELEMETRY=false
CHROMA_TELEMETRY=false
CHROMA_ENABLE_TELEMETRY=false
POSTHOG_DISABLED=1
